{
  "name": "modgator",
  "permissions": {
    "reddit": true,
    "redis": true,
    "http": {
      "domains": [
        "api.github.com"
      ]
    }
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "index.html"
      }
    }
  },
  "dev": {
    "subreddit": "modgator_dev"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Open MG Dashboard",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/dashboard"
      },
      {
        "label": "MG Actions",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-actions"
      },
      {
        "label": "MG Actions",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/comment-actions"
      }
    ]
  },
  "forms": {
    "yamlUpload": "/internal/form/yaml-upload-submit",
    "executeUiAction": "/internal/form/execute-ui-action"
  },
  "triggers": {
    "onPostSubmit": "/internal/triggers/on-post-submit",
    "onCommentCreate": "/internal/triggers/on-comment-create",
    "onPostReport": "/internal/triggers/on-post-report",
    "onCommentReport": "/internal/triggers/on-comment-report",
    "onPostUpdate": "/internal/triggers/on-post-update",
    "onCommentUpdate": "/internal/triggers/on-comment-update",
    "onModMail": "/internal/triggers/on-mod-mail"
  },
  "scheduler": {
    "tasks": {
      "yaml-runner": {
        "endpoint": "/internal/scheduler/yaml-runner"
      }
    }
  }
}